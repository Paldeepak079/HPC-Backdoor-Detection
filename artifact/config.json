{
  "seed": 42,
  "alpha": 0.05,
  "cv_folds": 5,
  "cv_repeats": 10,
  "streaming": {
    "enabled": false,
    "n_trees": 25,
    "height": 8,
    "window_size": 250
  },
  "detectors": {
