    "iforest": {
      "enabled": false,
      "n_estimators": 200,
      "max_samples": 256
    },
    "knn": {
      "enabled": false,
      "k": 10
    },
    "gmm": {
      "enabled": false,
      "max_components": 6
    },
    "ocsvm": {
      "enabled": false,
      "nu": 0.05,
      "kernel": "rbf"
    },
    "pyod_ecod": {
      "enabled": false
    }
  },
  "fusion": {
    "rule": "mean"
  },
  "preprocess": {
    "transform": "log1p",
    "scaler": "robust",
    "add_ratios": true
  }
}